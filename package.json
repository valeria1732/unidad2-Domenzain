{
  "name": "gestor-tareas",
  "version": "1.0.0",
  "description": "API de tareas para el ejercicio de CI y monitoreo",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --ci --coverage"
  },
  "dependencies": {
    "express": "^4.21.2",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageReporters": ["text", "json-summary", "lcov"],
    "coverageThreshold": {
      "global": { "lines": 80 }
    }
  }
}
