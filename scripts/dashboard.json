{
  "dashboard": {
    "uid": "gestor-tareas",
    "title": "Gestor de tareas",
    "timezone": "browser",
    "refresh": "5s",
    "time": { "from": "now-15m", "to": "now" },
    "schemaVersion": 39,
    "panels": [
      { "id": 1, "type": "timeseries", "title": "Peticiones por segundo", "gridPos": {"x":0,"y":0,"w":12,"h":8},
        "datasource": {"type":"prometheus","uid":"PROM"}, "fieldConfig": {"defaults":{"unit":"reqps"},"overrides":[]},
        "targets": [{"refId":"A","expr":"sum by (route) (rate(http_request_duration_seconds_count[1m]))","legendFormat":"{{route}}"}] },
      { "id": 2, "type": "timeseries", "title": "Latencia p95 por ruta", "gridPos": {"x":12,"y":0,"w":12,"h":8},
        "datasource": {"type":"prometheus","uid":"PROM"}, "fieldConfig": {"defaults":{"unit":"s"},"overrides":[]},
        "targets": [{"refId":"A","expr":"histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket[1m])))","legendFormat":"{{route}}"}] },
      { "id": 3, "type": "timeseries", "title": "Errores 5xx por segundo", "gridPos": {"x":0,"y":8,"w":8,"h":8},
        "datasource": {"type":"prometheus","uid":"PROM"}, "fieldConfig": {"defaults":{"unit":"reqps"},"overrides":[]},
        "targets": [{"refId":"A","expr":"sum(rate(http_request_duration_seconds_count{status_code=~\"5..\"}[1m])) or vector(0)"}] },
      { "id": 4, "type": "timeseries", "title": "Uso de CPU del proceso", "gridPos": {"x":8,"y":8,"w":8,"h":8},
        "datasource": {"type":"prometheus","uid":"PROM"}, "fieldConfig": {"defaults":{"unit":"none"},"overrides":[]},
        "targets": [{"refId":"A","expr":"rate(process_cpu_seconds_total[1m])"}] },
      { "id": 5, "type": "timeseries", "title": "Retardo del bucle de eventos (p99)", "gridPos": {"x":16,"y":8,"w":8,"h":8},
        "datasource": {"type":"prometheus","uid":"PROM"}, "fieldConfig": {"defaults":{"unit":"s"},"overrides":[]},
        "targets": [{"refId":"A","expr":"nodejs_eventloop_lag_p99_seconds"}] },
      { "id": 6, "type": "timeseries", "title": "Memoria residente", "gridPos": {"x":0,"y":16,"w":24,"h":7},
        "datasource": {"type":"prometheus","uid":"PROM"}, "fieldConfig": {"defaults":{"unit":"bytes"},"overrides":[]},
        "targets": [{"refId":"A","expr":"process_resident_memory_bytes"}] }
    ]
  },
  "overwrite": true
}
